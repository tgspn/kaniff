# Normalize line endings on commit, check out native on each platform.
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.slnx      text
*.props     text
*.targets   text
*.axaml     text
*.json      text
*.yml       text
*.yaml      text
*.md        text
*.sh        text eol=lf
*.ps1       text eol=crlf

# Binary files
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.zip       binary
*.nupkg     binary
*.dll       binary
*.exe       binary
*.pdb       binary

# Keep generated/vendored files out of language stats and diffs
*.Designer.cs linguist-generated=true
