<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Kaniff.Desktop.ViewModels.Tools"
             x:Class="Kaniff.Desktop.Views.Tools.JsonView"
             x:DataType="vm:JsonViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="{Binding Description}" Opacity="0.7" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Format" Command="{Binding FormatCommand}" />
                <Button Content="Minify" Command="{Binding MinifyCommand}" />
                <Button Content="Validate" Command="{Binding ValidateCommand}" />
            </StackPanel>
            <SelectableTextBlock Text="{Binding Status}" FontFamily="Consolas,monospace" />
        </StackPanel>

        <Grid RowDefinitions="*,*" RowSpacing="8">
            <TextBox Grid.Row="0" PlaceholderText="Input JSON"
                     Text="{Binding Input}"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Consolas,monospace" />
            <TextBox Grid.Row="1" PlaceholderText="Output"
                     Text="{Binding Output}" IsReadOnly="True"
                     AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Consolas,monospace" />
        </Grid>
    </DockPanel>
</UserControl>
